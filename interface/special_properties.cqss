/*  ------------------------------------------------------------------------ */
/* Custom QSS File for QtMaterial
/* Default Variables: https://github.com/UN-GCPDS/qt-material?tab=readme-ov-file#environ-variables
/* Stylesheet usage: https://github.com/UN-GCPDS/qt-material?tab=readme-ov-file#custom-stylesheets
/*  ------------------------------------------------------------------------  */


/* Custom classes */

.no_frame {{
    border: {QTMATERIAL_SECONDARYDARKCOLOR};
}}

.no_bg {{
    background: {QTMATERIAL_SECONDARYDARKCOLOR};
}}

.bigger_text {{
    font-size: {PACKEDMC_BIGGER_TEXT_SIZE}px;
}}

.colored_text {{
    color: {QTMATERIAL_PRIMARYCOLOR};
}}

.create_new_element_button {{
    font-size: {PACKEDMC_BIGGER_TEXT_SIZE}px;
    color: {QTMATERIAL_PRIMARYCOLOR};
}}

.clickable_frame_unselected:hover {{
    background-color: {PACKEDMC_FRAME_HOVER_COLOR};
}}

.clickable_frame_selected {{
    background-color: {PACKEDMC_BUTTON_PRESSED_COLOR};
}}

.clickable_frame_selected:hover {{
    background-color: {PACKEDMC_BUTTON_HOVER_COLOR};
}}


/* Base modifications */

QSpinBox {{
    selection-background-color: transparent;
}}

QPushButton:hover {{
    background-color: {PACKEDMC_BUTTON_HOVER_COLOR};
}}

QPushButton:pressed:hover {{
    background-color: {PACKEDMC_BUTTON_PRESSED_COLOR};
}}

QPushButton:pressed {{
    background-color: {PACKEDMC_BUTTON_PRESSED_COLOR};
}}

QComboBox:hover {{
    background-color: {PACKEDMC_BUTTON_HOVER_COLOR};
}}

QComboBox:on {{
    background-color: {QTMATERIAL_PRIMARYCOLOR};
}}

QCheckBox::indicator:hover {{
    background-color: {PACKEDMC_BUTTON_HOVER_COLOR};
}}


/* Page selection buttons & frame */

.selection_frame {{
    border: none;
    background-color: {QTMATERIAL_SECONDARYCOLOR};
}}

.selection {{
    border: none;
    background-color: {QTMATERIAL_SECONDARYCOLOR};
    font-size: {PACKEDMC_SELECTION_BUTTON_TEXT_SIZE}px;
}}

.selection:checked {{
    color: {QTMATERIAL_SECONDARYCOLOR};
}}

.selection:checked:hover {{
    background-color: {QTMATERIAL_PRIMARYCOLOR};
}}

.selection:disabled {{
    border: none;
}}



/* Select the whole row in the TableWidget */

QTableView::item:selected {{
    background-color: {QTMATERIAL_PRIMARYCOLOR};
}}

QTableView {{
    border: 2px solid {QTMATERIAL_SECONDARYLIGHTCOLOR};
}}



/* Instance page specific settings */

.play_button {{
    background-color: {QTMATERIAL_PRIMARYCOLOR};
    color: {QTMATERIAL_SECONDARYCOLOR};
}}

.play_button:hover {{
    background-color: {PACKEDMC_PLAY_HOVER_COLOR};
    border-color: {PACKEDMC_PLAY_HOVER_COLOR};
}}

.play_button:pressed:hover {{
    background-color: {QTMATERIAL_PRIMARYLIGHTCOLOR};
}}

.play_button:pressed {{
    background-color: {QTMATERIAL_PRIMARYLIGHTCOLOR};
}}


